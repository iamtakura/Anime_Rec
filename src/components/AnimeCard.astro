---
interface Props {
  anime: {
    id: string;
    title: string;
    year: number;
    episodes: number;
    rating: number;
    description: string;
    image: string;
  };
}

const { anime } = Astro.props;
---

<div class="anime-card" tabindex="0" data-anime={JSON.stringify(anime)} data-image={anime.image}>
  <div class="card-image-wrapper">
    {anime.image && <img src={anime.image} alt={anime.title} class="card-image" loading="lazy" decoding="async" />}
    {!anime.image && <div class="card-image-placeholder">No Image</div>}
  </div>
  <div class="card-content">
    <h3 class="card-title">{anime.title}</h3>
    <div class="card-meta">
      <span class="meta-item year">{anime.year}</span>
      <span class="meta-item separator">•</span>
      <span class="meta-item episodes">{anime.episodes} EPS</span>
      <span class="meta-item separator">•</span>
      <span class="meta-item rating">★ {anime.rating}</span>
    </div>
    <div class="card-mobile-desc">
      {anime.description}
    </div>
  </div>
</div>

<script>
  // Setup hover listeners for AnimeCards
  // We use event delegation or querySelectorAll for all cards on the page.
  const setupCards = () => {
    const cards = document.querySelectorAll('.anime-card');
    
    cards.forEach(card => {
      // Remove old listeners if re-running
      const newCard = card.cloneNode(true);
      card.parentNode?.replaceChild(newCard, card);
      
      newCard.addEventListener('mouseenter', () => {
        const animeDataStr = newCard.getAttribute('data-anime');
        if (!animeDataStr) return;
        
        const animeData = JSON.parse(animeDataStr);
        const imageSrc = newCard.getAttribute('data-image');
        
        const event = new CustomEvent('anime:hover', {
          detail: { ...animeData, imageSrc },
          bubbles: true
        });
        newCard.dispatchEvent(event);
      });

      // Mobile tap to expand
      newCard.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          newCard.classList.toggle('expanded');
        }
      });

      // Keyboard support for accessibility
      newCard.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter') {
          if (window.innerWidth <= 768) {
            newCard.classList.toggle('expanded');
          } else {
            // On desktop, perhaps simulate hover or focus state, but for now we just handle mobile
            const event = new CustomEvent('anime:hover', {
              detail: { ...animeData, imageSrc },
              bubbles: true
            });
            newCard.dispatchEvent(event);
          }
        }
      });
    });
  };

  // Run once DOM is loaded
  document.addEventListener('DOMContentLoaded', setupCards);
</script>

<style>
  .anime-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
    padding: 1rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .anime-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--primary-color);
  }

  .card-image-wrapper {
    overflow: hidden;
    border-radius: 8px;
    aspect-ratio: 2 / 3;
    background: rgba(255, 255, 255, 0.05);
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .card-image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.9rem;
  }

  .anime-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-title {
    font-size: 1.5rem;
    font-family: 'Bebas Neue', sans-serif;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    color: #fff;
    transition: color 0.3s ease;
  }

  .anime-card:hover .card-title {
    color: var(--primary-color);
  }

  .card-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
  }

  .separator {
    color: rgba(255, 255, 255, 0.2);
  }

  .rating {
    color: var(--primary-color);
  }

  .card-mobile-desc {
    display: none;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.8);
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .anime-card.expanded .card-mobile-desc {
      display: block;
      animation: fadeIn 0.3s ease;
    }
    
    .anime-card.expanded {
      grid-column: 1 / -1; /* Take up full width on mobile when expanded */
      border-color: var(--primary-color);
      background: rgba(255, 255, 255, 0.05);
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

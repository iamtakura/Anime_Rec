---
import BaseLayout from '../layouts/BaseLayout.astro';
import GenreSection from '../components/GenreSection.astro';
import ProgressNav from '../components/ProgressNav.astro';
import animeData from '../data/anime-data.json';

// Eager load all images to pass to components
const images = import.meta.glob('/src/assets/images/*.jpg', { eager: true });
---

<BaseLayout title="Where Do I Start? | Your First Anime, Sorted" description="A beautiful, interactive guide to finding your perfect first anime based on genre.">
  <!-- Grid overlay for premium feel -->
  <div class="grid-overlay"></div>

  <ProgressNav genres={animeData.genres} />

  <!-- Hero Section -->
  <header class="hero-section">
    <div class="hero-content">
      <div class="tagline-badge">An Interactive Beginner's Guide</div>
      <h1 class="main-title">Where Do<br/><span class="accent-text">I Start?</span></h1>
      <p class="subheading">Your first anime, sorted.</p>
      <div class="scroll-indicator">
        <span class="mouse-icon">
          <span class="wheel"></span>
        </span>
        <span class="scroll-text">Scroll to explore genres</span>
      </div>
    </div>
  </header>

  <!-- Genre Sections -->
  <main>
    {animeData.genres.map(genre => (
      <GenreSection genre={genre} images={images} />
    ))}
  </main>
</BaseLayout>

<style>
  /* Premium Grid Overlay */
  .grid-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 80px 80px;
    background-position: center center;
    pointer-events: none;
    z-index: 10;
  }

  /* Hero Section Styling */
  .hero-section {
    position: relative;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: radial-gradient(circle at center, #111111 0%, #080808 100%);
    overflow: hidden;
    padding: 2rem;
  }

  .hero-content {
    position: relative;
    z-index: 5;
  }

  .tagline-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.7);
    animation: fadeInDown 1s ease-out;
  }

  .main-title {
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 0.9;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    font-weight: 900;
    color: #ffffff;
    animation: scaleIn 1.2s ease-out;
  }

  .accent-text {
    background: linear-gradient(135deg, #FF4500, #FF6B9D);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subheading {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.05em;
    margin-bottom: 3rem;
    animation: fadeInUp 1s ease-out 0.3s both;
  }

  .scroll-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    animation: fadeInUp 1s ease-out 0.6s both;
  }

  .mouse-icon {
    width: 24px;
    height: 40px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    position: relative;
  }

  .wheel {
    width: 4px;
    height: 8px;
    background-color: #ffffff;
    border-radius: 2px;
    position: absolute;
    top: 6px;
    left: 50%;
    transform: translateX(-50%);
    animation: scrollWheel 2s infinite;
  }

  .scroll-text {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.4);
  }

  /* Micro animations */
  @keyframes scrollWheel {
    0% { opacity: 1; top: 6px; }
    50% { opacity: 0; top: 22px; }
    100% { opacity: 1; top: 6px; }
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes scaleIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  document.addEventListener('DOMContentLoaded', () => {
    gsap.registerPlugin(ScrollTrigger);

    const heroContent = document.querySelector('.hero-content');
    const heroBg = document.querySelector('.hero-section');
    
    if (heroContent && heroBg) {
      // Parallax on heading: moves at 0.4x scroll speed
      gsap.to(heroContent, {
        y: () => window.innerHeight * 0.4,
        opacity: 0,
        ease: "none",
        scrollTrigger: {
          trigger: heroBg,
          start: "top top",
          end: "bottom top",
          scrub: true,
        }
      });
      
      // Subtle depth effect as user scrolls past the hero
      gsap.to(heroBg, {
        scale: 0.95,
        filter: 'blur(4px)',
        ease: "none",
        scrollTrigger: {
          trigger: heroBg,
          start: "top top",
          end: "bottom top",
          scrub: true,
        }
      });
    }
  });
</script>
